@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema</title>

    <script>
        const theme = localStorage.getItem("theme") || "light";
        document.documentElement.classList.add(theme);
    </script>

    <script src="~/js/themehandler.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/theme.css" />
</head>
<body class="min-h-screen bg-[var(--back)] text-[var(--text)] flex items-center justify-center">
    @RenderBody()
    <div id="toast" class="bg-[var(--back)] h-20 fixed right-2 shadow-xl border-2 bottom-10 flex text-center justify-center items-center rounded-lg p-3">
        Mensagem: Fulano de tal tal coisa.
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/auth/register.js"></script>
</body>
</html>